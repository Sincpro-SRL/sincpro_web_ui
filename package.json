{
  "name": "@sincpro/web-ui",
  "version": "0.1.0",
  "description": "An enterprise web design system for business software — ERPs, back offices, management tools — in React and Tailwind: tokens, primitives, components and the two views every management screen is made of.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./foundations": {
      "types": "./dist/foundations/index.d.ts",
      "default": "./dist/foundations/index.js"
    },
    "./primitives": {
      "types": "./dist/primitives/index.d.ts",
      "default": "./dist/primitives/index.js"
    },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "default": "./dist/components/index.js"
    },
    "./views": {
      "types": "./dist/views/index.d.ts",
      "default": "./dist/views/index.js"
    },
    "./tokens.css": "./dist/tokens.css"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "prettier": {
    "printWidth": 94
  },
  "peerDependencies": {
    "@tanstack/react-table": "^9.2.4",
    "@tanstack/react-virtual": "^3.13.0",
    "react": ">=19",
    "react-dom": ">=19",
    "tailwindcss": "^4.3.0"
  },
  "dependencies": {
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lint": "^6.9.7",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@internationalized/date": "^3.12.4",
    "@uiw/react-codemirror": "^4.25.11",
    "lucide-react": "^1.45.0",
    "react-aria": "^3.53.1",
    "react-aria-components": "^1.22.1",
    "tailwind-variants": "^4.0.0",
    "tailwindcss-react-aria-components": "^2.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@storybook/addon-a11y": "10.6.0",
    "@storybook/addon-docs": "10.6.0",
    "@storybook/addon-mcp": "10.6.0",
    "@storybook/react-vite": "10.6.0",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-table": "^9.2.4",
    "@tanstack/react-virtual": "^3.14.12",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "prettier": "^3.9.8",
    "puppeteer-core": "^23.11.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "storybook": "10.6.0",
    "tailwindcss": "4.3.3",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.23.13",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "8.3.0"
  },
  "keywords": [
    "design-system",
    "enterprise",
    "erp",
    "react",
    "tailwindcss",
    "ui",
    "sincpro"
  ],
  "homepage": "https://github.com/Sincpro-SRL/sincpro_web_ui#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sincpro-SRL/sincpro_web_ui.git"
  },
  "bugs": {
    "url": "https://github.com/Sincpro-SRL/sincpro_web_ui/issues"
  },
  "author": "Gutierrez, Andres <andres.gutierrez@sincpro.com.bo>",
  "license": "MIT",
  "engines": {
    "node": ">=26"
  }
}
